# -------- Core runtime --------
AGENT_ENV=prod
AGENT_ALLOW_PLAINTEXT=false

AGENT_GRPC_BIND=0.0.0.0:50051
AGENT_GRPC_WORKERS=16
AGENT_MAX_MESSAGE_BYTES=8388608

AGENT_HEALTH_PORT=8089
AGENT_METRICS_PORT=9102

# -------- TLS / mTLS --------
AGENT_TLS_ENABLED=false
AGENT_MTLS_ENABLED=false
AGENT_TLS_CERT_PATH=/certs/server.pem
AGENT_TLS_KEY_PATH=/certs/server.key
AGENT_TLS_CLIENT_CA_PATH=/certs/ca.pem

# -------- JWT verify --------
AGENT_JWT_ENABLED=true
AGENT_JWT_ALGORITHM=HS256
AGENT_JWT_SECRET=change-me-change-me-change-me-change-me
AGENT_JWT_PUBLIC_KEY_PATH=/certs/jwt-public.pem
AGENT_JWT_JWKS_URL=
AGENT_JWT_ISSUER=agent-bridge-java
AGENT_JWT_AUDIENCE=python-agent-gateway

# -------- Rate Limit --------
AGENT_RATE_LIMIT_QPS=100

# -------- Async / TaskStore --------
AGENT_WORKERS=8
AGENT_ASYNC_RETRY_MAX=1
AGENT_TASK_TTL_SEC=86400
AGENT_IDEMPOTENCY_TTL_SEC=86400

AGENT_TASK_STORE=redis
AGENT_REDIS_HOST=redis
AGENT_REDIS_PORT=6379
AGENT_REDIS_DB=0
AGENT_REDIS_USER=
AGENT_REDIS_PASSWORD=
AGENT_REDIS_TIMEOUT_SEC=2
AGENT_REDIS_KEY_PREFIX=agentbridge
